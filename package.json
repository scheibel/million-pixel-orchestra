{
  "name": "million-pixel-orchestra",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "node scripts/serve.mjs",
    "build": "node scripts/build.mjs",
    "build:site": "node scripts/build-site.mjs",
    "build:pdf": "node scripts/build-documents.mjs",
    "publish:pages": "node scripts/publish-pages.mjs",
    "preview": "node scripts/serve.mjs --root dist",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node tests/browser.mjs"
  }
}
